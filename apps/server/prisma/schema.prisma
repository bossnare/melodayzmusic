// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider               = "prisma-client" // no "*-js"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm" // This is the module format for the generated Prisma client
  generatedFileExtension = "ts" // This is the file extension for the generated Prisma client (!important for TypeScript projects)
  importFileExtension    = "js" // This is the file extension for the generated Prisma client import (!important for TypeScript projects)
  binaryTargets          = ["native"] // native, generated compatibility direct for your system
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  ARTIST
  FAN
  MODERATOR
  SUPERADMIN
}

// Model
model User {
  id            String    @id @default(uuid())
  email         String    @unique
  firstName     String
  lastName      String
  username      String    @unique
  password      String
  role          Role      @default(USER)
  resetToken    String?
  resetTokenExp DateTime?
  verified      Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  song          Song[]
}

model Song {
  id        String   @id @default(uuid())
  title     String
  artist    String?
  genre     String?
  audioUrl  String?
  duration  Int?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
}
